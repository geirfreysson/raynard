{
  "name": "raynard",
  "version": "0.3.0",
  "description": "Barebones Raynard-inspired Tauri desktop chat app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:desktop": "npm run build && npm run runtime:prepare",
    "release:validate": "node scripts/validate-release-version.mjs",
    "runtime:prepare": "node scripts/standalone-runtime.mjs",
    "runtime:prepare:macos-arm64": "node scripts/standalone-runtime.mjs --target aarch64-apple-darwin",
    "runtime:prepare:linux-x64": "node scripts/standalone-runtime.mjs --target x86_64-unknown-linux-gnu",
    "runtime:prepare:windows-x64": "node scripts/standalone-runtime.mjs --target x86_64-pc-windows-msvc",
    "test:runtime": "vitest run scripts/standalone-runtime.test.mjs",
    "verify:macos:bundle": "node scripts/verify-standalone-bundle.mjs macos src-tauri/target/aarch64-apple-darwin/release/bundle/macos/Raynard.app"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@raynard/plugin-sdk": "file:scripts/plugin-sdk",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
